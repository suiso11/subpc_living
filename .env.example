# Template for .env used by compose.yaml.
# Copy to .env, replace every placeholder with real values, and NEVER commit
# the resulting .env (it is git-ignored). This file itself contains only safe
# placeholders and is the only env file tracked in git.

# --- Postgres ---
# Application user / database name (non-secret; adjust as you like).
POSTGRES_USER=subpc
POSTGRES_DB=subpc

# REQUIRED: change this before first start. Use a long random string,
# e.g. $(openssl rand -base64 24). Do NOT keep "change-me".
POSTGRES_PASSWORD=change-me-long-random-secret

# --- Network ---
# Loopback-only by default so the database is never exposed to the LAN or
# internet. Only widen this deliberately (e.g. a Tailscale IP) if you know why.
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=5432

# --- センサー opt-in (safe default) ---
# カメラ・画面・活動・マイク・PCメトリクス・プロセス詳細など機微なセンサーは
# 既定で無効。有効化は canonical 名の明示 `true` のみで、false / 未設定 / 不正値
# は必ず無効 (fail closed)。共有 SensorPolicy (src/perception/policy.py) が全入口
# (Web / Discord / Voice / CLI / Desktop) のゲートをこの env から一度だけ解決する。
# token / secret / 生データは保存・公開しない。
SENSOR_CAMERA_ENABLED=false
SENSOR_SCREEN_CAPTURE_ENABLED=false
SENSOR_SCREEN_INGEST_ENABLED=false
SENSOR_ACTIVITY_ENABLED=false
SENSOR_MONITOR_ENABLED=false
SENSOR_MICROPHONE_ENABLED=false
SENSOR_PROCESS_DETAILS_ENABLED=false
# 注: SENSOR_SCREEN_INGEST_ENABLED=true だけでは /api/screen/ingest は有効化されない。
# Web サービス側に共有トークン (SCREEN_INGEST_TOKEN) の設定も必要 (token は認証の
# ための共有鍵であり、opt-in の同意を意味しない)。本ファイルに token 値は入れない。

# --- 音声発話からのカレンダー書き込み (独立 opt-in, 既定オフ) ---
# マイク同意 (--microphone / SENSOR_MICROPHONE_ENABLED=true) だけではカレンダーへは
# 一切書き込まない。明示 `true` のみ音声パイプラインの「予定入れて」等による
# Google Calendar 直接登録を許可する (fail closed: false / 未設定 / 不正値は無効)。
# 無効時は認識テキストがローカル LLM / セッションの通常経路へ進むだけで、
# 予定登録は行われない。読み取り (upcoming.json 注入) はこの opt-in と無関係。
VOICE_CALENDAR_WRITE_ENABLED=false
