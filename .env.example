# Template for .env used by compose.yaml.
# Copy to .env, replace every placeholder with real values, and NEVER commit
# the resulting .env (it is git-ignored). This file itself contains only safe
# placeholders and is the only env file tracked in git.

# --- Postgres ---
# Application user / database name (non-secret; adjust as you like).
POSTGRES_USER=subpc
POSTGRES_DB=subpc

# REQUIRED: change this before first start. Use a long random string,
# e.g. $(openssl rand -base64 24). Do NOT keep "change-me".
POSTGRES_PASSWORD=change-me-long-random-secret

# --- Network ---
# Loopback-only by default so the database is never exposed to the LAN or
# internet. Only widen this deliberately (e.g. a Tailscale IP) if you know why.
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=5432
