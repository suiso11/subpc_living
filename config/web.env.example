# Web UI サーバー (subpc-web.service) 用の環境変数の例。
# 実ファイルは config/web.env (git 管理外)。subpc-web.service が EnvironmentFile で読み込む。
# 変更後は: systemctl --user restart subpc-web.service

# ブラウザ読み上げの TTS バックエンド:
#   kokoro           = ONNX ローカル推論 (既定。jf_alpha など)
#   style_bert_vits2 = subpc-sbv2-tts.service の SBV2 サーバーを使う (つくよみちゃん等)
# style_bert_vits2 の場合は subpc-sbv2-tts.service が起動している必要がある。
TTS_BACKEND=style_bert_vits2
SBV2_TTS_VOICE=tsukuyomi-chan

# 画面認識を有効化する (スクリーンショット→VLM描写→チャット返信にコンテキスト注入)。
# 無効 (未設定/false) なら Screen 機能は起動しない。
WEB_SCREEN_CONTEXT_ENABLED=false

# 画面認識のモード:
#   local  = このサブPC自身の画面を mss でキャプチャして VLM 描写する (X11 DISPLAY が必要)
#   remote = メインPC (Windows) のキャプチャエージェントが push した画面を
#            サーバーが VLM 描写した結果 (data/screen/latest.json) を読むだけ。
#            サブPC 側ではキャプチャも VLM 呼び出しもしない。
# default: local
SCREEN_CONTEXT_MODE=local

# メインPC のキャプチャエージェント (scripts/screen_agent.py) からの
# POST /api/screen/ingest を受け付けるための共有トークン。
# 未設定の場合、ingest エンドポイントは常に 403 で拒否する (安全側デフォルト)。
# remote モードで使うときは、ここと scripts/screen_agent.py の
# --token / SCREEN_AGENT_TOKEN を同じ値にする。十分に長いランダム文字列を推奨。
SCREEN_INGEST_TOKEN=
