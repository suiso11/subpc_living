# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Optional: set a single guild ID for instant slash-command sync while developing.
DISCORD_GUILD_ID=

# Optional comma-separated allowlists. Recommended for any bot invited outside a private server.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# Optional comma-separated channel IDs where every normal message gets an LLM reply.
# If empty, DISCORD_ALLOWED_CHANNEL_IDS is used.
# To make voice STT transcripts get an LLM reply, include DISCORD_VOICE_TRANSCRIPT_CHANNEL_ID
# here and map that channel to a short profile in config/chat_config.json.
DISCORD_AUTO_REPLY_CHANNEL_IDS=

# Set true to allow /service start|stop|restart from Discord.
DISCORD_ALLOW_SERVICE_CONTROL=false

# tmux-backed terminal bridge. Keep disabled unless the channel is private.
# Requires tmux on the host. Messages must start with DISCORD_TERMINAL_PREFIX.
DISCORD_ALLOW_TERMINAL=false
DISCORD_TERMINAL_CHANNEL_IDS=
DISCORD_TERMINAL_PREFIX=!t
DISCORD_TERMINAL_WORKDIR=/home/haruka/ドキュメント/subpc_living
DISCORD_TERMINAL_SESSION_PREFIX=subpc_discord
DISCORD_TERMINAL_CAPTURE_LINES=80

# Discord voice-channel STT. Keep disabled unless everyone in the channel expects transcription.
# The bot joins the command user's voice channel and posts transcripts to this channel.
DISCORD_VOICE_STT_ENABLED=true
DISCORD_VOICE_TRANSCRIPT_CHANNEL_ID=1521793947163295805
DISCORD_VOICE_TIMEZONE=Asia/Tokyo
DISCORD_VOICE_STT_LANGUAGE=ja
DISCORD_VOICE_STT_MODEL=auto
DISCORD_VOICE_STT_DEVICE=auto
DISCORD_VOICE_STT_COMPUTE_TYPE=auto
DISCORD_VOICE_STT_DEVICE_INDEX=0
DISCORD_VOICE_STT_ENERGY_THRESHOLD=0.008
# 無音でこのms数続くと発話終了と判定する。考えながら話すなら 900〜1100 推奨
# (短いほど断片化しやすい。返信側は下記デバウンスで断片を結合する)
DISCORD_VOICE_STT_SILENCE_MS=700
DISCORD_VOICE_STT_PAD_MS=240
DISCORD_VOICE_STT_MIN_MS=400
DISCORD_VOICE_STT_MAX_SECONDS=12
DISCORD_VOICE_STT_QUEUE_SIZE=16
DISCORD_VOICE_STT_SAVE_TRANSCRIPTS=true
DISCORD_VOICE_STT_HALLUCINATION_FILTER=true
DISCORD_VOICE_TRANSCRIPT_DIR=data/discord_voice/transcripts
# 通話 transcript への自動返信のデバウンス。断片が届いてもすぐ返信せず、同じ話者の
# 後続断片をこのms数待って結合し、1回だけ返信する。0 で従来どおり断片ごと即返信。
DISCORD_VOICE_REPLY_DEBOUNCE_MS=3000
# 最初の断片からこのms数を過ぎたら、まだ話し続けていても強制的に返信する (無限待ち防止)。
DISCORD_VOICE_REPLY_DEBOUNCE_MAX_MS=10000
# Diagnostics only: dir to dump the exact 16kHz mono audio sent to Whisper.
# Leave unset in normal operation; enable briefly to inspect STT quality.
#DISCORD_VOICE_STT_DEBUG_AUDIO_DIR=data/discord_voice/debug_audio

# Voice-channel TTS playback (/voice say + auto readout of LLM replies to
# voice transcripts while the bot is connected to the call).
# Voices: jvnv-F1-jp (JVNV 7-style), tsukuyomi-chan (つくよみちゃんコーパス, Neutral only)
DISCORD_VOICE_TTS_BACKEND=style_bert_vits2
DISCORD_VOICE_TTS_VOICE=jvnv-F1-jp
DISCORD_VOICE_TTS_SPEED=0.95
DISCORD_VOICE_TTS_AUTOREAD=true
DISCORD_VOICE_TTS_MAX_CHARS=500

# Daily diary posting. This is intentionally separate from auto-reply and terminal channels.
DIARY_ENABLED=false
DISCORD_DIARY_CHANNEL_ID=
DIARY_POST_TIME=23:50
DIARY_TIMEZONE=Asia/Tokyo
DIARY_PERSONALIZATION_ENABLED=true
DIARY_PERSONALIZATION_MIN_CONFIDENCE=0.72

# Google Calendar MCP source for diary context. Calendar failures do not stop diary generation.
DIARY_CALENDAR_ENABLED=true
DIARY_CALENDAR_ID=primary
GOOGLE_OAUTH_CREDENTIALS=/home/haruka/.config/google-calendar-mcp/gcp-oauth.keys.json
# Optional:
# GOOGLE_CALENDAR_MCP_TOKEN_PATH=/home/haruka/.config/google-calendar-mcp/tokens.json
# GOOGLE_CALENDAR_MCP_COMMAND=npx -y @cocal/google-calendar-mcp
# GOOGLE_CALENDAR_MCP_TIMEOUT_SEC=60

# Conversation/feedback logs for future fine-tuning data.
# Stored under data/ by default, which is git-ignored.
DISCORD_TRAINING_LOG_ENABLED=true
DISCORD_TRAINING_DIR=data/discord_training
# On 👎, generate rewrite candidates and offer pick-buttons to save a
# preferred/rejected pair with two taps. Set false to disable.
DISCORD_CORRECTION_SUGGESTIONS_ENABLED=true

# Proactive speech: the bot starts conversations on its own (schedule reminders,
# break suggestions, greetings, PC alerts) in a text channel. Backed by the same
# ProactiveEngine as the voice pipeline (src/persona/proactive.py).
DISCORD_PROACTIVE_ENABLED=false
# Target channel for proactive messages (required when enabled).
DISCORD_PROACTIVE_CHANNEL_ID=
# Rewrite the canned notification text into the persona's tone via the LLM
# (throwaway call, does not touch chat history). On failure the raw text is sent.
DISCORD_PROACTIVE_LLM_REWRITE=true
# How often the engine checks trigger conditions, in seconds.
DISCORD_PROACTIVE_CHECK_INTERVAL=60

# Task management + escalation reminders. The reminder engine runs only in the
# Discord bot process (v1) and checks every 60s. Reminders are delivered to
# DISCORD_PROACTIVE_CHANNEL_ID (fallback: first DISCORD_AUTO_REPLY_CHANNEL_IDS).
# Escalation: 24h before -> 3h before -> 1h before (every 30m) -> overdue (every 2h).
TASKS_REMINDER_ENABLED=true
# Local hours during which only overdue reminders are sent (others carry over).
# Format "start-end" in 24h local time. Default 1-8 (01:00-08:00).
TASKS_QUIET_HOURS=1-8
# Always-on task board: a pinned embed listing open tasks with a "＋追加" button
# and a Select menu to complete/snooze/delete. Refreshes after every change plus
# every 15 min. Buttons survive restarts (persistent views).
TASKS_BOARD_ENABLED=true
# Channel to host the board. Falls back to the reminder delivery channel
# (DISCORD_PROACTIVE_CHANNEL_ID -> first DISCORD_AUTO_REPLY_CHANNEL_IDS) if unset.
DISCORD_TASK_BOARD_CHANNEL_ID=

# Task <-> Google Calendar two-way sync (uses the same @cocal/google-calendar-mcp
# server and OAuth credentials as the diary). Disabled by default.
# When enabled: dated tasks are mirrored to the calendar (all-day for date-only
# tasks, a 30-min block ending at the deadline for datetime tasks). Summaries use
# "📋 <title>"; completed -> "✅ <title>"; dropped -> deleted. Each synced event
# carries a "subpc-task:<id>" marker in its description so it is never re-imported.
# Calendar failures never fail the task operation itself (async worker + retries).
TASKS_CALENDAR_SYNC_ENABLED=false
# Target calendar for task events. Defaults to DIARY_CALENDAR_ID (then "primary").
TASKS_CALENDAR_ID=
# How often to pull the next 7 days of events into data/calendar/upcoming.json and
# refresh today/tomorrow entries in the proactive profile schedule. Minutes.
CALENDAR_SYNC_INTERVAL_MIN=20

# Screen context: capture the sub-PC screen periodically, describe it with the
# vision-capable chat model, and inject "what the user is doing" into replies.
# Requires X11 (DISPLAY) reachable from the service. Default: disabled.
DISCORD_SCREEN_CONTEXT_ENABLED=false
# Screen context mode:
#   local  = capture THIS sub-PC's own screen with mss (needs X11 DISPLAY)
#   remote = read the description of the Windows main PC's screen that the web
#            server produced from scripts/screen_agent.py pushes
#            (data/screen/latest.json; no capture, no VLM call here).
# In remote mode the web service must run with SCREEN_INGEST_TOKEN set so the
# main PC can POST /api/screen/ingest. Default: local.
SCREEN_CONTEXT_MODE=local
