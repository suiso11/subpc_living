# Python
.venv/
.venv-*/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# データ（個人データはgitに含めない）
data/
.env
config/discord.env
config/web.env

# モデル・バイナリ（サイズが大きいためgit管理外）
# models/* (not models/) so the tracked Modelfile template below can be
# re-included; git cannot re-include files under a fully excluded directory.
models/*
tools/*

# 例外: Ollama Modelfile のテンプレートは追跡する
!models/ollama/
!models/ollama/Modelfile.personal.example

# training の成果物（チェックポイント・評価結果）は管理外
training/checkpoints/
training/outputs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# アプリログ (RotatingFileHandler 出力)
logs/
